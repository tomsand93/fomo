PORT=3000

# Local dev only. In production this MUST be an absolute path on the mounted
# volume (/data/events.csv on Fly): state.json and flyers/ are placed next to it,
# so a relative path puts all three inside the container, where every deploy
# wipes them.
EVENTS_FILE=events.csv

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DIGEST_TO=whatsapp:+972525676445

# Required in production. The Twilio webhook signature is computed over this URL,
# so an unset or wrong value rejects every inbound message with 403 — the bot
# goes silent. It's also the base for the flyer links Twilio fetches.
PUBLIC_BASE_URL=

ADMIN_PHONE=+972528762432

OPENROUTER_API_KEY=
# Field extraction — a small model does this well, and it runs on every message.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Customer-facing Hebrew prose. Set separately: bad grammar here is visible to the
# whole group, and this path runs far less often than extraction.
OPENROUTER_INQUIRY_MODEL=anthropic/claude-sonnet-5
# Routes a stranger's first message: submit / inquire / other. Runs in front of
# every one of them, so it wants to be small and fast. Unset or a failed call means
# the sender gets the menu — never a silently-started event draft.
OPENROUTER_INTENT_MODEL=anthropic/claude-haiku-4.5

# Event reminders. Unset means off, deliberately: a reminder fires long after the
# user last messaged, so it needs the approved fomo_event_reminder template to be
# delivered at all, and promising one the bot cannot send is worse than not
# offering it. Turn on (1/true/yes/on) only once that template is approved —
# see reminder-template.md.
REMINDERS_ENABLED=

# Paid publication is not built. See payplus.md for the intended flow if it
# comes back — the webhook endpoint and its settings were removed as dead code.
